from __future__ import annotations
 
from typing import Any, Dict, List
 
import pandas as pd
import streamlit as st
 
st.set_page_config(page_title="HITL Review — EDA Copilot", layout="wide")
 
st.markdown(
    """
    <style>
    @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Syne:wght@700;800&display=swap');
    html, body, [class*="css"] { font-family: 'DM Mono', monospace; }
    h1, h2, h3 { font-family: 'Syne', sans-serif !important; letter-spacing: -0.03em; }
 
    .risk-high   { background:#3a1a1a; border:1px solid #f87171; color:#fca5a5;
                   padding:12px 16px; border-radius:3px; margin-bottom:8px; }
    .risk-medium { background:#3a2a1a; border:1px solid #fb923c; color:#fdba74;
                   padding:12px 16px; border-radius:3px; margin-bottom:8px; }
    .risk-low    { background:#1a2a1a; border:1px solid #4ade80; color:#86efac;
                   padding:12px 16px; border-radius:3px; margin-bottom:8px; }
 
    .action-row  { background:#111827; border:1px solid #1f2937;
                   border-radius:3px; padding:10px 14px; margin-bottom:6px; }
    .action-type { color:#6c63ff; font-weight:500; font-size:0.82rem; }
    .action-col  { color:#94a3b8; font-size:0.78rem; }
    .action-rat  { color:#6b7280; font-size:0.75rem; font-style:italic; }
 
    .diff-label  { font-size:0.7rem; letter-spacing:0.1em; text-transform:uppercase;
                   color:#6b7280; margin-bottom:4px; }
    .diff-before { border-left:3px solid #f87171; padding-left:8px; }
    .diff-after  { border-left:3px solid #4ade80; padding-left:8px; }
 
    .approve-btn > button { background:#14532d !important; border-color:#4ade80 !important;
                            color:#4ade80 !important; }
    .reject-btn  > button { background:#450a0a !important; border-color:#f87171 !important;
                            color:#f87171 !important; }
    </style>
    """,
    unsafe_allow_html=True,
)
 
# ── Guard ─────────────────────────────────────────────────────────────────
job_id = st.session_state.get("job_id")
if not job_id:
    st.warning("No active job — go to **Upload** first.")
    st.stop()
 
# ── Load pending payload ──────────────────────────────────────────────────
from utils.api_client import get_hitl_payload, submit_hitl_decision
 
payload = get_hitl_payload(job_id)
 
st.title("HITL Review")
st.caption(f"Job `{job_id}`")
 
if payload is None:
    st.info("No pending review for this job. The pipeline is either still running or the decision was already submitted.")
    if st.button("↩  Back to Monitor"):
        st.switch_page("pages/2_Job_Monitor.py")
    st.stop()
 
plan_dict   = payload.get("plan_json") or {}
risk_result = payload.get("risk_json") or {}
diff_data   = payload.get("diff_json") or {}
 
# ── Risk summary ──────────────────────────────────────────────────────────
risk_level = str(risk_result.get("risk_level", "UNKNOWN")).upper()
reasons: List[str] = risk_result.get("reasons", [])
 
css_class = {"HIGH": "risk-high", "MEDIUM": "risk-medium"}.get(risk_level, "risk-low")
reasons_html = "".join(f"<li>{r}</li>" for r in reasons) if reasons else "<li>No reasons provided.</li>"
 
st.markdown(
    f'<div class="{css_class}">'
    f"<strong>Risk Level: {risk_level}</strong>"
    f"<ul style='margin:6px 0 0 0; padding-left:18px;'>{reasons_html}</ul>"
    f"</div>",
    unsafe_allow_html=True,
)
 
st.divider()
 
# ── Proposed actions ──────────────────────────────────────────────────────
st.subheader("Proposed Transformation Plan")
 
actions: List[Dict[str, Any]] = (
    plan_dict.get("actions") or
    plan_dict.get("transforms") or
    []
)
 
if actions:
    # Table view
    action_rows = []
    for a in actions:
        action_rows.append({
            "action_id":   a.get("action_id") or a.get("id", "—"),
            "action_type": a.get("action_type", "—"),
            "column":      ", ".join(a.get("target_columns", [])) or a.get("column", "—"),
            "rationale":   (a.get("parameters") or {}).get("rationale", a.get("rationale", "—")),
        })
    action_df = pd.DataFrame(action_rows)
    st.dataframe(action_df, use_container_width=True, hide_index=True)
else:
    st.caption("No actions found in plan payload.")
 
st.divider()
 
# ── Column-level diff ─────────────────────────────────────────────────────
st.subheader("Column-Level Diff (sample)")
 
if diff_data and isinstance(diff_data, dict):
    affected_cols = list(diff_data.keys())
    if affected_cols:
        for col_name in affected_cols[:8]:  # cap at 8 for readability
            col_diff = diff_data[col_name]
            if not isinstance(col_diff, dict):
                continue
            before = col_diff.get("before", {})
            after  = col_diff.get("after", {})
 
            st.markdown(f"**`{col_name}`**")
            b_col, a_col = st.columns(2)
 
            with b_col:
                st.markdown('<p class="diff-label">Before</p>', unsafe_allow_html=True)
                with st.container():
                    if isinstance(before, dict):
                        for k, v in before.items():
                            st.metric(k, v)
                    else:
                        st.write(before)
 
            with a_col:
                st.markdown('<p class="diff-label">After (projected)</p>', unsafe_allow_html=True)
                with st.container():
                    if isinstance(after, dict):
                        for k, v in after.items():
                            before_val = before.get(k) if isinstance(before, dict) else None
                            delta = None
                            if before_val is not None:
                                try:
                                    delta = round(float(v) - float(before_val), 4)
                                except (TypeError, ValueError):
                                    delta = None
                            st.metric(k, v, delta=delta)
                    else:
                        st.write(after)
            st.markdown("---")
    else:
        st.caption("Diff data present but no column entries found.")
else:
    st.caption("No diff data available for this plan. Review the action table above.")
 
st.divider()
 
# ── Context metadata (collapsed) ─────────────────────────────────────────
with st.expander("Full plan payload (JSON)", expanded=False):
    st.json(plan_dict)
 
with st.expander("Full risk result (JSON)", expanded=False):
    st.json(risk_result)
 
st.divider()
 
# ── Decision ─────────────────────────────────────────────────────────────
st.subheader("Your Decision")
st.caption("This will resume or replan the pipeline.")
 
reject_reason = st.text_area(
    "Rejection reason (optional — required for REJECT)",
    placeholder="e.g. Drop-column actions are too aggressive; prefer imputation instead.",
    height=80,
)
 
approve_col, reject_col, _ = st.columns([1, 1, 3])
 
with approve_col:
    st.markdown('<div class="approve-btn">', unsafe_allow_html=True)
    approve_clicked = st.button("✅  Approve", use_container_width=True)
    st.markdown("</div>", unsafe_allow_html=True)
 
with reject_col:
    st.markdown('<div class="reject-btn">', unsafe_allow_html=True)
    reject_clicked = st.button("❌  Reject", use_container_width=True)
    st.markdown("</div>", unsafe_allow_html=True)
 
if approve_clicked:
    submit_hitl_decision(job_id, action="APPROVED")
    st.session_state.hitl_pending = False
    st.success("✅ Approved — the pipeline will resume shortly.")
    st.balloons()
    st.rerun()
 
if reject_clicked:
    if not reject_reason.strip():
        st.warning("Please enter a rejection reason so the planner can address it.")
    else:
        submit_hitl_decision(job_id, action="REJECTED", reason=reject_reason.strip())
        st.session_state.hitl_pending = False
        st.warning("❌ Rejected — the planner will generate a new plan.")
        st.rerun()